<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>Online Job Application Form</title>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    background-color: #eef2f3;
    margin: 0;
    padding: 40px;
  }

  .container {
    max-width: 900px;
    margin: auto;
    background-color: #ffffff;
    padding: 35px;
    border-radius: 12px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  }

  h1 {
    text-align: center;
    color: #2c3e50;
    margin-bottom: 30px;
    font-size: 26px;
  }

  fieldset {
    border: 2px solid #d0d0d0;
    border-radius: 8px;
    padding: 20px 25px;
    margin-bottom: 25px;
    background-color: #f9f9f9;
  }

  legend {
    font-size: 22px;
    font-weight: 600;
    color: #34495e;
    padding: 0 8px;
    background-color: #f1f1f1;
    border-radius: 4px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  label {
    display: block;
    font-weight: 600;
    margin-bottom: 8px;
    color: #3a3a3a;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 15px;
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: #2980b9;
    box-shadow: 0 0 8px rgba(41, 128, 185, 0.2);
  }

  .gender-options {
    display: flex;
    gap: 30px;
    margin-top: 8px;
  }

  .gender-options label {
    font-weight: normal;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .error {
    color: #e74c3c;
    font-size: 13px;
    margin-top: 4px;
    display: block;
  }

  .valid {
    border: 2px solid #27ae60;
  }

  .invalid {
    border: 2px solid #e74c3c;
  }

  button {
    width: 100%;
    padding: 15px;
    background-color: #2980b9;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 18px;
    cursor: pointer;
    transition: background-color 0.3s, transform 0.2s;
  }

  button:hover {
    background-color: #1f6391;
    transform: translateY(-2px);
  }

  #successMessage {
    display: none;
    text-align: center;
    color: #155724;
    background-color: #d4edda;
    border: 1px solid #c3e6cb;
    padding: 15px;
    border-radius: 8px;
    margin-top: 25px;
    font-weight: 600;
  }

  .required {
    color: #e74c3c;
  }
</style>
</head>

<body>

<div class="container">

<h1>Online Job Application Form</h1>

<form id="jobForm">

<!-- ================= PERSONAL INFORMATION ================= -->

<fieldset>
  <legend>Personal Information</legend>

  <div class="form-group">
    <label for="fullName">
      Full Name <span class="required">*</span>
    </label>
    <input type="text" id="fullName" placeholder="Enter your full name" />
    <span class="error" id="nameError"></span>
  </div>

  <div class="form-group">
    <label for="dob">
      Date of Birth <span class="required">*</span>
    </label>
    <input type="date" id="dob" />
    <span class="error" id="dobError"></span>
  </div>

  <div class="form-group">
    <label>
      Gender <span class="required">*</span>
    </label>
    <div class="gender-options">
      <label>
        <input type="radio" name="gender" value="Male" />
        Male
      </label>
      <label>
        <input type="radio" name="gender" value="Female" />
        Female
      </label>
      <label>
        <input type="radio" name="gender" value="Other" />
        Other
      </label>
    </div>
    <span class="error" id="genderError"></span>
  </div>

  <div class="form-group">
    <label for="email">
      Email Address <span class="required">*</span>
    </label>
    <input type="email" id="email" placeholder="example@gmail.com" />
    <span class="error" id="emailError"></span>
  </div>

  <div class="form-group">
    <label for="mobile">
      Mobile Number <span class="required">*</span>
    </label>
    <input
      type="text"
      id="mobile"
      placeholder="Enter 10-digit mobile number"
      maxlength="10"
    />
    <span class="error" id="mobileError"></span>
  </div>

  <div class="form-group">
    <label for="address">
      Address <span class="required">*</span>
    </label>
    <textarea
      id="address"
      placeholder="Enter your complete address"
    ></textarea>
    <span class="error" id="addressError"></span>
  </div>

  <div class="form-group">
    <label for="city">
      City <span class="required">*</span>
    </label>
    <input type="text" id="city" placeholder="Enter city" />
    <span class="error" id="cityError"></span>
  </div>

  <div class="form-group">
    <label for="state">
      State <span class="required">*</span>
    </label>
    <input type="text" id="state" placeholder="Enter state" />
    <span class="error" id="stateError"></span>
  </div>

  <div class="form-group">
    <label for="pin">
      PIN Code <span class="required">*</span>
    </label>
    <input
      type="text"
      id="pin"
      placeholder="Enter 6-digit PIN code"
      maxlength="6"
    />
    <span class="error" id="pinError"></span>
  </div>
</fieldset>

<!-- ================= EDUCATIONAL INFORMATION ================= -->

<fieldset>
  <legend>Educational Qualification</legend>

  <div class="form-group">
    <label for="qualification">
      Highest Qualification <span class="required">*</span>
    </label>
    <select id="qualification">
      <option value="">Select Qualification</option>
      <option value="10th">10th</option>
      <option value="12th">12th</option>
      <option value="Diploma">Diploma</option>
      <option value="Bachelor's Degree">Bachelor's Degree</option>
      <option value="Master's Degree">Master's Degree</option>
      <option value="PhD">PhD</option>
    </select>
    <span class="error" id="qualificationError"></span>
  </div>

  <div class="form-group">
    <label for="university">
      University / Institute <span class="required">*</span>
    </label>
    <input
      type="text"
      id="university"
      placeholder="Enter university or institute"
    />
    <span class="error" id="universityError"></span>
  </div>

  <div class="form-group">
    <label for="passingYear">
      Passing Year <span class="required">*</span>
    </label>
    <input
      type="number"
      id="passingYear"
      placeholder="Example: 2025"
    />
    <span class="error" id="passingYearError"></span>
  </div>

  <div class="form-group">
    <label for="percentage">
      Percentage / CGPA <span class="required">*</span>
    </label>
    <input
      type="number"
      id="percentage"
      step="0.01"
      placeholder="Enter percentage or CGPA"
    />
    <span class="error" id="percentageError"></span>
  </div>
</fieldset>

<!-- ================= PROFESSIONAL INFORMATION ================= -->

<fieldset>
  <legend>Professional Information</legend>

  <div class="form-group">
    <label for="position">
      Applying For / Job Position <span class="required">*</span>
    </label>
    <input
      type="text"
      id="position"
      placeholder="Example: Software Developer"
    />
    <span class="error" id="positionError"></span>
  </div>

  <div class="form-group">
    <label for="experience">
      Total Work Experience (Years) <span class="required">*</span>
    </label>
    <input
      type="number"
      id="experience"
      min="0"
      step="0.1"
      placeholder="Example: 2"
    />
    <span class="error" id="experienceError"></span>
  </div>

  <div class="form-group">
    <label for="organization">
      Current / Previous Organization <span class="required">*</span>
    </label>
    <input
      type="text"
      id="organization"
      placeholder="Enter organization name"
    />
    <span class="error" id="organizationError"></span>
  </div>

  <div class="form-group">
    <label for="designation">
      Current Designation <span class="required">*</span>
    </label>
    <input
      type="text"
      id="designation"
      placeholder="Example: Software Engineer"
    />
    <span class="error" id="designationError"></span>
  </div>

  <div class="form-group">
    <label for="salary">
      Expected Salary <span class="required">*</span>
    </label>
    <input
      type="number"
      id="salary"
      min="0"
      placeholder="Enter expected salary"
    />
    <span class="error" id="salaryError"></span>
  </div>
</fieldset>

<!-- ================= TECHNICAL SKILLS ================= -->

<fieldset>
  <legend>Technical Skills</legend>

  <div class="form-group">
    <label for="languages">
      Programming Languages <span class="required">*</span>
    </label>
    <input
      type="text"
      id="languages"
      placeholder="Example: Python, Java, C++"
    />
    <span class="error" id="languagesError"></span>
  </div>

  <div class="form-group">
    <label for="skills">
      Technical Skills <span class="required">*</span>
    </label>
    <textarea
      id="skills"
      placeholder="Example: HTML, CSS, JavaScript, SQL"
    ></textarea>
    <span class="error" id="skillsError"></span>
  </div>

  <div class="form-group">
    <label for="certifications">
      Certifications
    </label>
    <textarea
      id="certifications"
      placeholder="Enter your certifications"
    ></textarea>
    <span class="error" id="certificationsError"></span>
  </div>
</fieldset>

<button type="submit">Submit Application</button>

<div id="successMessage">
  Application submitted successfully!
</div>

</form>

</div>

<script>
  // Your validation scripts remain unchanged.
  // You can keep your existing JavaScript as is.
</script>

</body>
</html>
