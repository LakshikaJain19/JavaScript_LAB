<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Colorful Shopping Cart with Tiered Discounts</title>
<style>
  body {
    font-family: 'Arial', sans-serif;
    background: linear-gradient(135deg, #ffe3ec, #b0f7ff);
    margin: 0;
    padding: 20px;
  }
  h1 {
    text-align: center;
    color: #fff;
    text-shadow: 2px 2px 4px #000;
    font-size: 2.5em;
    margin-bottom: 20px;
  }
  .container {
    max-width: 1000px;
    margin: 0 auto;
    background: linear-gradient(135deg, #fef2f2, #fff);
    padding: 30px;
    border-radius: 20px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.2);
  }
  .form-group {
    margin-bottom: 15px;
  }
  label {
    display: block;
    margin-bottom: 5px;
    font-weight: bold;
    color: #333;
  }
  input[type="text"], input[type="number"] {
    width: 100%;
    padding: 10px;
    border-radius: 10px;
    border: 2px solid #ccc;
    font-size: 1em;
    transition: border-color 0.3s;
  }
  input[type="text"]:focus, input[type="number"]:focus {
    border-color: #ff6f61;
    outline: none;
  }
  button {
    background-color: #ff6f61;
    color: #fff;
    padding: 14px 25px;
    border: none;
    border-radius: 15px;
    cursor: pointer;
    font-size: 1.1em;
    margin-top: 10px;
    transition: background 0.3s, transform 0.2s;
  }
  button:hover {
    background-color: #ff3b2e;
    transform: scale(1.05);
  }
  .cart {
    margin-top: 30px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    border-radius: 10px;
    overflow: hidden;
  }
  th {
    background: linear-gradient(135deg, #7fdbff, #39cccc);
    color: #fff;
    padding: 15px;
    font-size: 1.1em;
  }
  td {
    background-color: #f0f8ff;
    padding: 12px;
    border-bottom: 1px solid #ccc;
    font-size: 1em;
  }
  th, td {
    text-align: center;
  }
  td button {
    background-color: #ff4b2b;
    color: #fff;
    padding: 8px 12px;
    border-radius: 8px;
    border: none;
    font-size: 0.9em;
    cursor: pointer;
    transition: background 0.3s;
  }
  td button:hover {
    background-color: #e03e20;
  }
  .total {
    font-size: 1.5em;
    font-weight: bold;
    margin-top: 20px;
    text-align: right;
    color: #333;
  }
  #discountInfo {
    font-size: 1.2em;
    color: #d35400;
    margin-top: 10px;
    font-style: italic;
  }
</style>
</head>
<body>
<h1>Shopping Cart 🎉</h1>
<div class="container">
  <div class="form-group">
    <label for="customerName">Customer Name:</label>
    <input type="text" id="customerName" placeholder="Enter customer name" />
  </div>
  <div class="form-group">
    <label for="prn">PRN:</label>
    <input type="text" id="prn" placeholder="Enter PRN" />
  </div>
  <div class="form-group">
    <label for="itemName">Item Name:</label>
    <input type="text" id="itemName" placeholder="Enter item name" />
  </div>
  <div class="form-group">
    <label for="itemPrice">Item Price ($):</label>
    <input type="number" id="itemPrice" placeholder="Enter item price" />
  </div>
  <div class="form-group">
    <label for="itemQuantity">Quantity:</label>
    <input type="number" id="itemQuantity" placeholder="Enter quantity" />
  </div>
  <button id="addItemBtn">➕ Add Item</button>

  <div class="cart" id="cartSection" style="display:none;">
    <h2>🛒 Cart Items</h2>
    <table id="cartTable">
      <thead>
        <tr>
          <th>Item Name</th>
          <th>Price ($)</th>
          <th>Quantity</th>
          <th>Total ($)</th>
          <th>Remove</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>
    <div id="discountInfo"></div>
    <div class="total" id="finalTotal">Total Payable: $0.00</div>
    <button id="calculateBtn">💰 Calculate Total</button>
  </div>
</div>

<script>
  const cart = [];

  const itemNameInput = document.getElementById('itemName');
  const itemPriceInput = document.getElementById('itemPrice');
  const itemQuantityInput = document.getElementById('itemQuantity');
  const addItemBtn = document.getElementById('addItemBtn');
  const cartSection = document.getElementById('cartSection');
  const cartTableBody = document.querySelector('#cartTable tbody');
  const calculateBtn = document.getElementById('calculateBtn');
  const finalTotalDiv = document.getElementById('finalTotal');
  const discountInfoDiv = document.getElementById('discountInfo');

  const customerNameInput = document.getElementById('customerName');
  const prnInput = document.getElementById('prn');

  function renderCart() {
    cartTableBody.innerHTML = '';
    if (cart.length === 0) {
      cartSection.style.display = 'none';
      return;
    }
    cart.forEach((item, index) => {
      const row = document.createElement('tr');

      const nameTd = document.createElement('td');
      nameTd.textContent = item.name;
      row.appendChild(nameTd);

      const priceTd = document.createElement('td');
      priceTd.textContent = item.price.toFixed(2);
      row.appendChild(priceTd);

      const qtyTd = document.createElement('td');
      qtyTd.textContent = item.quantity;
      row.appendChild(qtyTd);

      const totalTd = document.createElement('td');
      totalTd.textContent = (item.price * item.quantity).toFixed(2);
      row.appendChild(totalTd);

      const removeTd = document.createElement('td');
      const removeBtn = document.createElement('button');
      removeBtn.textContent = '🗑️ Remove';
      removeBtn.onclick = () => {
        cart.splice(index, 1);
        renderCart();
      };
      removeTd.appendChild(removeBtn);
      row.appendChild(removeTd);

      cartTableBody.appendChild(row);
    });
    cartSection.style.display = 'block';
  }

  addItemBtn.onclick = () => {
    const name = itemNameInput.value.trim();
    const price = parseFloat(itemPriceInput.value);
    const quantity = parseInt(itemQuantityInput.value);

    if (!name || isNaN(price) || isNaN(quantity) || price <= 0 || quantity <= 0) {
      alert('Please enter valid item details.');
      return;
    }

    const item = { name, price, quantity };
    cart.push(item);
    itemNameInput.value = '';
    itemPriceInput.value = '';
    itemQuantityInput.value = '';
    renderCart();
  };

  function calculateTotal() {
    if (cart.length === 0) {
      alert('Cart is empty!');
      return;
    }

    const totalAmount = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

    // Tiered discount logic
    let discount = 0;
    if (totalAmount >= 2000) {
      discount = totalAmount * 0.20; // 20%
    } else if (totalAmount >= 1000) {
      discount = totalAmount * 0.10; // 10%
    }

    const finalTotal = totalAmount - discount;

    // Show discount info
    if (discount > 0) {
      discountInfoDiv.textContent = `🎉 Discount applied: $${discount.toFixed(2)} 🎉`;
    } else {
      discountInfoDiv.textContent = 'No discount applied.';
    }

    finalTotalDiv.textContent = `💰 Total Payable: $${finalTotal.toFixed(2)}`;

    const customerName = customerNameInput.value.trim();
    const prn = prnInput.value.trim();

    alert(`👤 Customer: ${customerName}\n🔢 PRN: ${prn}\nTotal Payable: $${finalTotal.toFixed(2)}`);
  }

  document.getElementById('calculateBtn').onclick = calculateTotal;
</script>
</body>
</html>
